# 数据库配置模板 —— 复制为 src/main/resources/db.properties 后按需修改
# 注意：db.password 留空，密码一律通过环境变量注入，不要提交真实密码
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/class_score?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
db.username=score_user
db.password=

# 环境变量覆盖规则（DBUtil 优先读取环境变量，其次读本文件）：
#   DB_URL      完整 JDBC URL，优先于 db.url
#   DB_USERNAME 数据库用户名
#   DB_PASSWORD 数据库密码（必填，为空时连接会给出明确报错）
# 服务端 Tomcat 9 推荐写在 $CATALINA_BASE/bin/setenv.sh，参见 scripts/tomcat-setenv.sh.template
